<?xml version="1.0" encoding="utf-8"?>
<resources>



        <!-- ============== BRAND GRADIENT STOPS ============== -->
        <!-- Used to build the 3 gradient drawables (blue / green / purple). Keep these as the
             single source of truth — never hardcode a hex in a layout or drawable again. -->
        <color name="gradient_blue_start">#2F6BFF</color>
        <color name="gradient_blue_end">#7B9CFF</color>

        <color name="gradient_green_start">#00B37E</color>
        <color name="gradient_green_end">#4EE6A8</color>

        <color name="gradient_purple_start">#7C4DFF</color>
        <color name="gradient_purple_end">#B388FF</color>

        <!-- ============== RAW BRAND / NEUTRAL PALETTE ============== -->
        <color name="brand_primary">#2F6BFF</color>
        <color name="brand_primary_dark">#1D4FD6</color>
        <color name="brand_secondary">#00B37E</color>
        <color name="brand_tertiary">#7C4DFF</color>
        <color name="brand_error">#E14B4B</color>

        <color name="brand_white">#FFFFFF</color>
        <color name="brand_black">#000000</color>

        <!-- Light-theme neutrals -->
        <color name="neutral_0">#FFFFFF</color>
        <color name="neutral_50">#FAFAFC</color>
        <color name="neutral_100">#F3F4F7</color>
        <color name="neutral_150">#EBEDF2</color>
        <color name="neutral_200">#E2E4EA</color>
        <color name="neutral_300">#D2D5DE</color>
        <color name="neutral_400">#A9AEBB</color>
        <color name="neutral_500">#7D8393</color>
        <color name="neutral_600">#5C6273</color>
        <color name="neutral_700">#3F4451</color>
        <color name="neutral_800">#282C36</color>
        <color name="neutral_900">#15171D</color>

        <color name="success">#1FAE71</color>
        <color name="warning">#F0A93A</color>
        <color name="info">#2F94D6</color>

        <!--
            Semantic tokens (light theme = default values/ folder).
            Layouts/styles reference ONLY these names. values-night/colors.xml redefines the
            same names for dark mode — never reference brand_*/neutral_* directly in layouts.
        -->
        <color name="color_primary">@color/brand_primary</color>
        <color name="color_on_primary">@color/brand_white</color>
        <color name="color_secondary">@color/brand_secondary</color>
        <color name="color_on_secondary">@color/brand_white</color>
        <color name="color_tertiary">@color/brand_tertiary</color>
        <color name="color_on_tertiary">@color/brand_white</color>

        <!-- Pure white app background, light theme -->
        <color name="color_background">#FFFFFF</color>
        <color name="color_on_background">@color/neutral_900</color>

        <!-- Smooth light-grey cards on white bg -->
        <color name="color_surface">#FFFFFF</color>
        <color name="color_on_surface">@color/neutral_900</color>
        <color name="color_surface_variant">@color/neutral_100</color>
        <color name="color_on_surface_variant">@color/neutral_600</color>
        <color name="color_card_bg">@color/neutral_50</color>

        <color name="color_outline">@color/neutral_200</color>
        <color name="color_error">@color/brand_error</color>
        <color name="color_on_error">@color/brand_white</color>

        <color name="color_disabled">@color/neutral_200</color>
        <color name="color_disabled_text">@color/neutral_400</color>
        <color name="color_divider">@color/neutral_150</color>
        <color name="color_hint">@color/neutral_500</color>
        <color name="color_success">@color/success</color>
        <color name="color_warning">@color/warning</color>
        <color name="color_text_secondary">@color/neutral_600</color>

        <!-- Status/nav bar are fully transparent — root layout background IS the bar color -->
        <color name="color_system_bars">#00000000</color>



</resources>
